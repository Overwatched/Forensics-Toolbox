{
  "name": "forensics-toolbox",
  "productName": "Forensics Toolbox",
  "version": "1.22.0",
  "description": "Lokal verktygslåda för IT-forensik. Encoding, hash, tidskonvertering, CyberChef m.m. Körs helt offline.",
  "author": "Overwatched",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "node scripts/run-tests.js",
    "postinstall": "node scripts/ensure-electron.js",
    "sync-version": "node scripts/sync-version.js",
    "sync-queries": "node scripts/sync-query-catalogs.js",
    "pack-html": "node scripts/pack-html-folder.js",
    "pack": "electron-builder --dir",
    "pack:linux": "npm run sync-version && electron-builder --linux --dir",
    "dist:linux": "npm run sync-version && electron-builder --linux AppImage",
    "dist:mac": "npm run sync-version && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac",
    "dist": "npm run sync-version && electron-builder --win && node scripts/finalize-artifacts.js",
    "dist:win": "npm run dist",
    "dist:installer": "npm run sync-version && electron-builder --win nsis && node scripts/finalize-artifacts.js",
    "dist:portable": "npm run sync-version && electron-builder --win zip && node scripts/finalize-artifacts.js",
    "fetch-maps": "node scripts/fetch-map-data.js"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.17.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.overwatched.forensics-toolbox",
    "productName": "Forensics Toolbox",
    "directories": {
      "output": "release"
    },
    "publish": null,
    "asar": false,
    "files": [
      "electron/**/*",
      "Toolbox.html",
      "src/**/*",
      "tools/**/*",
      "documentation/**/*",
      "queries/**/*",
      "package.json",
      "maps/kartdata.json",
      "maps/*.pmtiles",
      "!**/*.md",
      "!tools/ios-keychain/sample-backup/**/*",
      "!tools/**/fixtures/**/*",
      "!**/*.test.js"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Utility",
      "icon": "build/icon.png",
      "artifactName": "ForensicsToolbox-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "ForensicsToolbox-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false,
      "artifactName": "ForensicsToolbox-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forensics Toolbox",
      "artifactName": "Forensics Toolbox Setup ${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
